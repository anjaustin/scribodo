# Run 6: back up from the app, then restore into a new folder (SOW §7).
# The restored project is separate from the original and has everything
# back: documents, History, notes, canon and chats.
wait 5
dialog "$DIR/book"
click_element WelcomeOpen
expect explorer_has "remember the lighthouse"
click_element BackupItem
wait_status "Backed up to" 1800
expect files "$DIR/backups" "book-" 1
dialog_latest "$DIR/backups"
click_element RestoreItem
wait_status "Restored as" 1800
expect files "$DIR" "book (restored" 1
expect explorer_has "Chapter One.md"
expect explorer_has "remember the lighthouse"
expect explorer_has "Old chat"
click_element DocItem0
expect text "Zoë Ångström climbed the stairs. Again."
expect element_w RevItem0 10 2000
expect element_w NoteItem1 10 2000
click_element CanonItem0
expect record "Ångström."
click_element RecordClose
# Its chat resumes with the documents it was sent with.
click_element ChatItem0
expect attached "Chapter One.md"
