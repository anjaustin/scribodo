# Boundary questions (manifold cycle step 2): fresh source-bound cases written
# before any model run; see tests/fixtures/answer_boundary/princess-of-mars.json. Each
# question is checked only for source delivery (memory_sources carries the
# designated passage). Reply quality is reviewed afterwards against the fixture's
# fields; the novel's answer vocabulary is never the pass oracle here.
# Generated by tools/answer_boundary_script.py; edit the fixture, not this file.
# Run: SCRIBODO_PRODUCT_SCRIPT=tests/ui/store/22_mars_boundary_questions.scribo \
#      SCRIBODO_MANUSCRIPT=build/manuscripts/a-princess-of-mars/parts \
#      python3 tools/answer_product_run.py <label> <live-capture app binary>

wait 5
dialog "$DIR/manuscript"
click_element WelcomeOpen
wait_status "now kept in the project store" 1800
expect explorer_has "Manuscript chat"
click_element ChatItem0
wait_history
# Attach every part (the menu lists the project's documents in explorer order).
click_element AttachAdd
click_element MenuItem0
click_element AttachAdd
click_element MenuItem1
click_element AttachAdd
click_element MenuItem2
click_element AttachAdd
click_element MenuItem3
click_element AttachAdd
click_element MenuItem4
click_element AttachAdd
click_element MenuItem5
click_element AttachAdd
click_element MenuItem6
click_element AttachAdd
click_element MenuItem7
expect attached "part01.md,part02.md,part03.md,part04.md,part05.md,part06.md,part07.md,part08.md"
# Memory over the chat and the eight attached parts.
expect memory_enabled no
measure_frames start
right_click_element ChatItem0
click_element MenuItem2
wait_memory 402 36000
wait_memory_documents 8 36000
measure_frames stop
expect memory_enabled yes
wait_ready 36000

# single_fact_sak_leap (single_fact)
click_element ChatInput
type "In my manuscript, how far does John Carter clear in his first deliberate sak leap before the Tharkian warriors?"
key ENTER
wait_chat 14400
expect chat_busy no
expect memory_sources "cleared a good hundred and fifty feet"

# two_entities_hordes (two_entities_different_values)
click_element ChatInput
type "How many souls do the hordes of Thark number, and how many Warhoons filled the amphitheater for the great games?"
key ENTER
wait_chat 14400
expect chat_busy no
expect memory_sources "number some thirty thousand souls"
expect memory_sources "the entire twenty thousand Warhoons"

# single_fact_kantos_kan (single_fact)
click_element ChatInput
type "Who is Kantos Kan when the narrator first meets him in the Warhoon dungeon?"
key ENTER
wait_chat 14400
expect chat_busy no
expect memory_sources "a padwar (lieutenant) in the navy of Hel"

# single_fact_thark_arrival (single_fact)
click_element ChatInput
type "How many days after his arrival on Barsoom does the narrator enter the city of Thark?"
key ENTER
wait_chat 14400
expect chat_busy no
expect memory_sources "Just thirty days after my advent upon Ba"

# author_correction (explicit_author_correction)
click_element ChatInput
type "Note for later: Dejah Thoris is the daughter of Tardos Mors."
key ENTER
wait_chat 14400
expect chat_busy no
click_element ChatInput
type "Earlier I told you Dejah Thoris is the daughter of Tardos Mors; I was wrong, the text says otherwise. Whose daughter does she say she is?"
key ENTER
wait_chat 14400
expect chat_busy no
expect memory_sources "daughter of Mors Kajak of Helium"

# contradictory_drafts (contradictory_dated_drafts)
click_element ChatInput
type "Draft note (older): In the first draft the atmosphere plant had ten radium pumps."
key ENTER
wait_chat 14400
expect chat_busy no
click_element ChatInput
type "My two drafts disagree about how many radium pumps the atmosphere factory has. Which figure does the current manuscript give, and what did the other draft say?"
key ENTER
wait_chat 14400
expect chat_busy no
expect memory_sources "a battery of twenty radium pumps"

# unavailable_fact (unavailable_fact)
click_element ChatInput
type "What is the name of John Carter's horse in the Arizona chapters of my manuscript?"
key ENTER
wait_chat 14400
expect chat_busy no

# creative_request (creative_speculative)
click_element ChatInput
type "Draft two sentences, in Burroughs's register, of Woola waiting outside the doors of the atmosphere factory. Mark it as new writing."
key ENTER
wait_chat 14400
expect chat_busy no
expect memory_sources "Woola and I stepped forth into the darkn"
