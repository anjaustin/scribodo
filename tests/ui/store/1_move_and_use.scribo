# Run 1 against a throwaway database (make uitest-db): a project with
# existing .scribodo files is moved into the project store on open, then
# used. Runs 2 and 3 reopen the same project.
wait 5
mkdir "$DIR/book"
write "$DIR/book/one.md" "Zoë Ångström climbed the stairs."
mkdir "$DIR/book/.scribodo"
mkdir "$DIR/book/.scribodo/chats"
write "$DIR/book/.scribodo/notes.jsonl" "{\"id\":\"n-20261101-100000-abcd\",\"ver\":1,\"ts\":1793500000,\"status\":\"active\",\"content\":\"An old note from the file store.\",\"sources\":[{\"kind\":\"doc\",\"doc\":\"one.md\",\"revision\":\"\",\"start\":0,\"len\":3,\"quote\":\"Zoë\"}]}\n"
write "$DIR/book/.scribodo/chats/20261101-100000-abcd.jsonl" "{\"type\":\"meta\",\"version\":1,\"title\":\"Old chat\",\"created\":1793500000}\n{\"type\":\"message\",\"role\":\"user\",\"content\":\"an old question\",\"ts\":1793500000,\"docs\":[\"one.md\"]}\n{\"type\":\"message\",\"role\":\"assistant\",\"content\":\"an old answer\",\"ts\":1793500001}\n"
dialog "$DIR/book"
click_element WelcomeOpen
expect status "now kept in the project store"
expect files "$DIR/book/.scribodo" "store.json" 1
expect files "$DIR/book/.scribodo" "notes.jsonl" 0
expect files "$DIR/book/.scribodo" "legacy-" 1
expect explorer_has "Old chat"
expect element_w NoteItem0 10 2000
# Use it: a saved revision, a note, canon, a chat.
click_element DocItem0
key DOWN cmd
type " Again."
key S cmd
expect element_w RevItem0 10 2000
click_index 0
key RIGHT shift
key RIGHT shift
key RIGHT shift
key N cmd shift
expect record "Note · v1"
click_element RecordClose
click_index 0
key RIGHT shift
key RIGHT shift
key RIGHT shift
key C cmd shift
click_element RecordEditor
key A cmd
type "Zoë's surname is Ångström."
click_element RecordCommit
expect record "Canon · v1 · committed"
click_element RecordClose
click_element ChatInput
type "remember the lighthouse"
key ENTER
wait_chat
expect chat_last "You said: remember the lighthouse"
# The observer reads from and writes to the store.
observer on
click_element ObserverToggle
wait_observer
expect findings_has "entity|new|Zoë is mentioned."
observer off
# A rename is one update: sources and History follow the document's id.
right_click_element DocItem0
click_element MenuItem0
key A cmd
type "Chapter One"
key ENTER
expect status "Renamed to Chapter One.md"
expect files "$DIR/book/.scribodo" "renames.jsonl" 0
expect element_w RevItem0 10 2000
click_element NoteItem0
click_element RecordSource
expect status "Source passage selected"
expect files "$DIR/book/.scribodo" "notes.jsonl" 0
expect files "$DIR/book/.scribodo" "chats" 0
