# Manuscript-scale baseline (MEMORY-015 S4). Seed with tests/seed_manuscript.py;
# run through tools/manuscript_baseline.sh, which samples RSS. Each phase is
# bracketed by measure_frames so its FRAME_METRICS line reports the phase's
# wall time (sample_seconds) and its worst interframe stall (max).
wait 5
dialog "$DIR/manuscript"
# Phase 1: first open of a legacy whole-manuscript project moves it into the store.
measure_frames start
click_element WelcomeOpen
# The move into the store runs on a worker; wait for it to finish.
wait_status "now kept in the project store" 1800
measure_frames stop
expect explorer_has "Manuscript chat"
expect files "$DIR/manuscript/.scribodo" "legacy-" 1
# Phase 2: open the long chat; the window is bounded regardless of archive size.
measure_frames start
click_element ChatItem0
wait_history
measure_frames stop
expect chat_count 64
expect chat_cache_max 67108864
# Phase 3: page back through history five times and return to the latest.
measure_frames start
click_element ChatOlder
wait_history
click_element ChatOlder
wait_history
click_element ChatOlder
wait_history
click_element ChatOlder
wait_history
click_element ChatOlder
wait_history
click_element ChatLatest
wait_history
measure_frames stop
expect chat_count 64
expect chat_cache_max 67108864
# Phase 4: open a chapter, edit, save, and see the revision recorded.
measure_frames start
click_element DocItem0
key DOWN cmd
type " Baseline edit."
key S cmd
expect element_w RevItem0 10 2000
measure_frames stop
expect dirty no
# Phase 5: send a message on the long chat (fake model by default; --real uses the pinned model).
wait_ready 36000
measure_frames start
click_element ChatItem0
wait_history
click_element ChatInput
type "A baseline question about the amber key."
key ENTER
wait_chat 14400
measure_frames stop
# The fake model echoes the prompt; the real model answers it. Either way a reply arrived.
expect chat_busy no
expect chat_cache_max 67108864
# Phase 6: enable memory for the whole 1,116-turn chat (fake tokenizer, real SQL and index).
expect memory_enabled no
measure_frames start
right_click_element ChatItem0
click_element MenuItem2
wait_memory 1116 36000
measure_frames stop
expect memory_enabled yes
# Phase 7: a Recall query over the whole archive plus canon.
measure_frames start
click_element RecallToggle
click_element RecallInput
type "amber key"
key ENTER
wait_recall 3600
measure_frames stop
expect recall "idle"
expect recall "memory_on=1"
expect recall "conversations=1"
expect recall_not "canon|"
click_element RecallToggle
