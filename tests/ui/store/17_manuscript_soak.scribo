# Manuscript-scale soak cycle (MEMORY-019). Seed with tests/seed_manuscript.py;
# tools/history_frame_soak.sh --manuscript repeats the cycle for the requested
# duration and samples app and service memory. Fake model; real store.
wait 5
dialog "$DIR/manuscript"
click_element WelcomeOpen
wait_status "now kept in the project store" 1800
click_element ChatItem0
wait_history
expect chat_count 64
measure_frames start
# SOAK_CYCLE_BEGIN
click_element ChatOlder
wait_history
click_element ChatOlder
wait_history
click_element ChatLatest
wait_history
click_element DocItem0
key DOWN cmd
type " soak"
key S cmd
expect dirty no
click_element ChatItem0
wait_history
click_element ChatInput
type "soak question about the amber key"
key ENTER
wait_chat 7200
wait 600
# SOAK_CYCLE_END
expect chat_count 64
expect chat_cache_max 67108864
measure_frames stop
