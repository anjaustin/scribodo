# Boundary questions (manifold cycle step 2): fresh source-bound cases written
# before any model run; see tests/fixtures/answer_boundary/wuthering-heights.json. Each
# question is checked only for source delivery (memory_sources carries the
# designated passage). Reply quality is reviewed afterwards against the fixture's
# fields; the novel's answer vocabulary is never the pass oracle here.
# Generated by tools/answer_boundary_script.py; edit the fixture, not this file.
# Run: SCRIBODO_PRODUCT_SCRIPT=tests/ui/store/23_heights_boundary_questions.scribo \
#      SCRIBODO_MANUSCRIPT=build/manuscripts/wuthering-heights/parts \
#      python3 tools/answer_product_run.py <label> <live-capture app binary>

wait 5
dialog "$DIR/manuscript"
click_element WelcomeOpen
wait_status "now kept in the project store" 1800
expect explorer_has "Manuscript chat"
click_element ChatItem0
wait_history
# Attach every part (the menu lists the project's documents in explorer order).
click_element AttachAdd
click_element MenuItem0
click_element AttachAdd
click_element MenuItem1
click_element AttachAdd
click_element MenuItem2
click_element AttachAdd
click_element MenuItem3
click_element AttachAdd
click_element MenuItem4
click_element AttachAdd
click_element MenuItem5
click_element AttachAdd
click_element MenuItem6
click_element AttachAdd
click_element MenuItem7
expect attached "part01.md,part02.md,part03.md,part04.md,part05.md,part06.md,part07.md,part08.md"
# Memory over the chat and the eight attached parts.
expect memory_enabled no
measure_frames start
right_click_element ChatItem0
click_element MenuItem2
wait_memory 402 36000
wait_memory_documents 8 36000
measure_frames stop
expect memory_enabled yes
wait_ready 36000

# single_fact_catherine_rides (single_fact)
click_element ChatInput
type "How old is Catherine Earnshaw when Nelly says she could already ride any horse in the stable?"
key ENTER
wait_chat 14400
expect chat_busy no
expect memory_sources "hardly six years old"

# single_fact_hindley_age (single_fact)
click_element ChatInput
type "How old is Hindley Earnshaw when his father comes home from Liverpool with the child Heathcliff?"
key ENTER
wait_chat 14400
expect chat_busy no
expect memory_sources "a boy of fourteen"

# relation_cousins (single_fact)
click_element ChatInput
type "How was the young Mrs. Heathcliff related to her husband, according to Nelly's account to Lockwood?"
key ENTER
wait_chat 14400
expect chat_busy no
expect memory_sources "her husband was her cousin also"

# two_entities_ages (two_entities_different_values)
click_element ChatInput
type "How old is Hareton when Nelly begins teaching him his letters, and until what age had the younger Catherine never once been beyond the range of the park by herself?"
key ENTER
wait_chat 14400
expect chat_busy no
expect memory_sources "nearly five years old"
expect memory_sources "reached the age of thirteen"

# author_correction (explicit_author_correction)
click_element ChatInput
type "Note for later: Hareton Earnshaw is Heathcliff's son."
key ENTER
wait_chat 14400
expect chat_busy no
click_element ChatInput
type "Earlier I told you Hareton Earnshaw is Heathcliff's son; I was wrong, the text says otherwise. Whose son is Hareton?"
key ENTER
wait_chat 14400
expect chat_busy no
expect memory_sources "that was Hareton’s father"

# contradictory_drafts (contradictory_dated_drafts)
click_element ChatInput
type "Draft note (older): In the first draft the ghost at the window said she had been a waif for ten years."
key ENTER
wait_chat 14400
expect chat_busy no
click_element ChatInput
type "My two drafts disagree about how long the ghost at the window says she has been a waif. Which figure does the current manuscript give, and what did the other draft say?"
key ENTER
wait_chat 14400
expect chat_busy no
expect memory_sources "a waif for twenty years"

# unavailable_fact (unavailable_fact)
click_element ChatInput
type "What is the name of the London street where Mr. Lockwood keeps his rooms?"
key ENTER
wait_chat 14400
expect chat_busy no

# creative_request (creative_speculative)
click_element ChatInput
type "Draft two sentences, in Brontë's register, of Nelly Dean listening to the wind at Wuthering Heights. Mark it as new writing."
key ENTER
wait_chat 14400
expect chat_busy no
expect memory_sources "atmospheric tumult to which its station "
