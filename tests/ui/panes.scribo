# Splitters, clamping, the observer toggle, and window resizing (1440x860).
open "$DIR/chapter.md"
expect explorer_w 209 211
expect editor_w 795 805
expect element_w Chat 419 421
expect element_w Observer 0 0
# Explorer splitter (x 210-215).
drag 212 400 330 400
expect explorer_w 325 330
# Chat splitter sits at the chat pane's left edge (x 1015-1020).
drag 1017 400 900 400
expect element_w Chat 535 540
# The observer opens from the toolbar.
click_element ObserverToggle
expect element_w Observer 259 261
shot panes-wide
# Dragging far past the limit clamps the explorer to 25% of the window.
drag 330 400 1200 400
expect explorer_w 359 361
# Shrinking to the minimum keeps the document at least 320 px wide:
# panes shrink to their minimums and the observer closes.
resize 900 600
expect editor_w 320 900
expect element_w Observer 0 0
shot panes-narrow
# The editor keeps focus after splitter drags.
type "x"
expect dirty yes
