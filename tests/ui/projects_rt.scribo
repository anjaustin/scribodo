# Red-team 006: projects and documents.
wait 5
mkdir "$DIR/book"
mkdir "$DIR/other"
write "$DIR/book/one.md" "Alpha beta gamma."
write "$DIR/other/ch1.md" "Other project chapter."
dialog "$DIR/book"
click_element WelcomeOpen
click_element DocItem0
# Nothing behind a prompt reacts: chat links, drops (a drop would switch
# projects under a rename prompt).
click_element ChatInput
type "Say something"
key ENTER
wait_chat
click_element Editor
key N cmd
expect element_w PromptField 100 2000
click_element ApplyLast
click_element NoteLast
expect element_w ReviewPanel 0 0
expect element_w RecordPanel 0 0
expect cursor 17
click_index 10
expect cursor 17
drop "$DIR/other"
expect element_w PromptField 100 2000
expect element_w DocItem0 10 2000
key ESC
expect element_w PromptField 0 0
# A case-only rename keeps the same file and its History (case-insensitive volume).
click_element Editor
type "X"
key S cmd
expect files "$DIR/book/.scribodo/revisions/one.md" "-save.md" 1
right_click_element DocItem0
click_element MenuItem0
key A cmd
type "One"
key ENTER
expect status "Renamed to One.md"
expect files "$DIR/book/.scribodo/revisions/One.md" "-save.md" 1
expect files "$DIR/book/.scribodo/revisions" "earlier" 0
expect element_w RevItem0 10 2000
# A name reused after a rename is a different document: its sources stay its own.
right_click_element DocItem0
click_element MenuItem0
key A cmd
type "two"
key ENTER
expect status "Renamed to two.md"
key N cmd
key A cmd
type "one"
key ENTER
expect status "Created one.md"
type "Fresh words here."
key S cmd
click_index 0
key RIGHT shift
key RIGHT shift
key RIGHT shift
key RIGHT shift
key RIGHT shift
key N cmd shift
click_element RecordClose
click_element DocItem1
expect text "Alpha beta gamma.X"
click_element NoteItem0
click_element RecordSource
expect text "Fresh words here."
expect status "Source passage selected"
# The context menu acts on the document it was opened for, even if the list re-sorts.
right_click_element DocItem1
write "$DIR/book/a-first.md" "Sorts first."
wait 240
click_element MenuItem0
key A cmd
type "z"
key ENTER
expect status "Renamed to z.md"
expect file "$DIR/book/a-first.md" "Sorts first."
expect file "$DIR/book/z.md" "Alpha beta gamma.X"
# .markdown files are listed; a failed History move is reported.
write "$DIR/elsewhere.markdown" "Imported markdown."
dialog "$DIR/elsewhere.markdown"
click_element ImportItem
expect status "Imported 1 of 1"
expect element_w DocItem3 10 2000
expect files "$DIR/book" "elsewhere.markdown" 1
click_element DocItem2
type "Y"
key S cmd
chmod "$DIR/book/.scribodo/revisions" 555
right_click_element DocItem2
click_element MenuItem0
key A cmd
type "last"
key ENTER
expect status "but History couldn't be moved"
chmod "$DIR/book/.scribodo/revisions" 755
