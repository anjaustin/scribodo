# Chats reference project documents by attachment (SOW §4.1-4.2): which are
# attached is shown, sent, remembered, and follows renames; chats rename.
wait 5
mkdir "$DIR/proj"
write "$DIR/proj/a.md" "Alpha."
write "$DIR/proj/b.md" "Beta."
write "$DIR/proj/c.md" "Gamma."
dialog "$DIR/proj"
click_element WelcomeOpen
click_element DocItem0
# A new conversation starts with the open document attached.
expect attached "a.md"
click_element AttachAdd
expect element_w MenuItem2 50 800
click_element MenuItem1
expect attached "a.md,b.md"
click_element ChatInput
type "compare them"
key ENTER
wait_chat
expect chat_last "(fake model, with 2 documents) You said: compare them"
# Removing an attachment: only what's attached is sent.
click_element AttachRemove1
expect attached "a.md"
click_element ChatInput
type "just one"
key ENTER
wait_chat
expect chat_last "(fake model, with document) You said: just one"
click_element AttachRemove0
click_element ChatInput
type "none"
key ENTER
wait_chat
expect chat_last "(fake model) You said: none"
# Toggling in the menu detaches.
click_element AttachAdd
click_element MenuItem2
expect attached "c.md"
click_element AttachAdd
click_element MenuItem2
expect attached ""
# Reopening a chat restores the attachments its last message was sent with.
click_element AttachAdd
click_element MenuItem1
click_element AttachAdd
click_element MenuItem2
expect attached "b.md,c.md"
click_element ChatInput
type "remember these"
key ENTER
wait_chat
click_element NewChatButton
expect attached "a.md"
expect chat_count 0
click_element ChatItem0
expect chat_count 8
expect attached "b.md,c.md"
# A renamed document stays attached under its new name.
right_click_element DocItem1
click_element MenuItem0
key A cmd
type "beta"
key ENTER
expect status "Renamed to beta.md"
expect attached "beta.md,c.md"
click_element ChatInput
type "still there?"
key ENTER
wait_chat
expect chat_last "(fake model, with 2 documents) You said: still there?"
# Chats rename from the Explorer.
right_click_element ChatItem0
click_element MenuItem0
key A cmd
type "Lighthouse plans"
key ENTER
expect status "Chat renamed"
expect explorer_has "Lighthouse plans"
# --- red-team 007 ---
# Reopening a chat restores exactly its newest message's attachments,
# including "none".
mkdir "$DIR/rt"
write "$DIR/rt/a.md" "Alpha."
write "$DIR/rt/b.md" "Beta."
write "$DIR/rt/c.md" "Gamma."
mkdir "$DIR/other"
write "$DIR/other/secret.md" "OTHER PROJECT SECRET"
dialog "$DIR/rt"
key O cmd
click_element DocItem0
click_element ChatInput
type "one"
key ENTER
wait_chat
click_element AttachRemove0
click_element ChatInput
type "two"
key ENTER
wait_chat
click_element NewChatButton
click_element ChatItem0
expect attached ""
# Opening documents doesn't undo the author's choice.
click_element AttachAdd
click_element MenuItem1
click_element AttachAdd
click_element MenuItem2
click_element NewChatButton
click_element AttachRemove0
click_element AttachAdd
click_element MenuItem1
click_element AttachAdd
click_element MenuItem2
expect attached "b.md,c.md"
click_element DocItem2
click_element DocItem0
expect attached "b.md,c.md"
# A tampered chat log can't attach paths outside the listed documents.
write "$DIR/rt/.scribodo/chats/20260101-000000-abcd.jsonl" "{\"type\":\"meta\",\"version\":1,\"title\":\"Tampered\",\"created\":1}\n{\"type\":\"message\",\"role\":\"user\",\"content\":\"hi\",\"ts\":1,\"docs\":[\"../other/secret.md\",\".scribodo/chats/20260101-000000-abcd.jsonl\",\"b.md\"]}\n{\"type\":\"message\",\"role\":\"assistant\",\"content\":\"hello\",\"ts\":2}\n"
wait 200
expect explorer_has "Tampered"
click_element ChatItem0
expect chat_count 2
expect attached "b.md"
# An edit request records only the edited document (reopen shows it).
click_element NewChatButton
click_element AttachAdd
click_element MenuItem1
expect attached "a.md,b.md"
click_index 2 2
key K cmd
type "loud"
key ENTER
wait_chat
click_element NewChatButton
click_element ChatItem0
expect attached "a.md"
# Many attachments: "+ Attach" never covers Send.
click_element AttachAdd
click_element MenuItem1
click_element AttachAdd
click_element MenuItem2
click_element ChatInput
type "send me"
click_element SendButton
wait_chat
expect chat_last "You said: send me"
