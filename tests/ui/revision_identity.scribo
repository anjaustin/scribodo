# Complete externally-created names with a shared >199-byte prefix must never share History.
wait 5
mkdir "$DIR/identity"
write "$DIR/identity/123456789012345678901234567890123456789012345678901234567890123456789012345678901234567890123456789012345678901234567890123456789012345678901234567890123456789012345678901234567890123456789012345678901234567890A.md" "FIRST"
write "$DIR/identity/123456789012345678901234567890123456789012345678901234567890123456789012345678901234567890123456789012345678901234567890123456789012345678901234567890123456789012345678901234567890123456789012345678901234567890B.md" "SECOND"
open "$DIR/identity/123456789012345678901234567890123456789012345678901234567890123456789012345678901234567890123456789012345678901234567890123456789012345678901234567890123456789012345678901234567890123456789012345678901234567890A.md"
key END cmd
type " A"
key S cmd
expect dirty no
expect element_w RevItem0 10 2000
open "$DIR/identity/123456789012345678901234567890123456789012345678901234567890123456789012345678901234567890123456789012345678901234567890123456789012345678901234567890123456789012345678901234567890123456789012345678901234567890B.md"
key END cmd
type " B"
key S cmd
expect dirty no
expect element_w RevItem0 10 2000
open "$DIR/identity/123456789012345678901234567890123456789012345678901234567890123456789012345678901234567890123456789012345678901234567890123456789012345678901234567890123456789012345678901234567890123456789012345678901234567890A.md"
expect text "FIRST A"
click_element RevItem0
expect text "FIRST A"
# An old sanitized bucket is unavailable, not silently attached to either manuscript.
mkdir "$DIR/ambiguous"
mkdir "$DIR/ambiguous/.scribodo"
mkdir "$DIR/ambiguous/.scribodo/revisions"
mkdir "$DIR/ambiguous/.scribodo/revisions/part_one.md"
write "$DIR/ambiguous/part:one.md" "COLON"
write "$DIR/ambiguous/part_one.md" "UNDERSCORE"
write "$DIR/ambiguous/.scribodo/revisions/part_one.md/index.jsonl" "{\"file\":\"20261125-120000-000-save.md\",\"origin\":\"save\",\"ts\":1,\"bytes\":5}\n"
write "$DIR/ambiguous/.scribodo/revisions/part_one.md/20261125-120000-000-save.md" "MIXED"
open "$DIR/ambiguous/part:one.md"
expect text "COLON"
expect status "History identity or storage could not be verified"
expect element_w RevItem0 0 0
expect file "$DIR/ambiguous/.scribodo/revisions/part_one.md/20261125-120000-000-save.md" "MIXED"
shot history-unavailable
